{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "akaunting/laravel-money": "^6.0",
        "andreiio/blade-remix-icon": "^1.1",
        "awcodes/filament-table-repeater": "^2.0",
        "blade-ui-kit/blade-icons": "^1.3",
        "chillerlan/php-qrcode": "^4.3",
        "doctrine/dbal": "^3.4",
        "filament/filament": "^3.3.55",
        "filament/spatie-laravel-media-library-plugin": "^3.3.55",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^13.17",
        "laravel/jetstream": "^5.5",
        "laravel/reverb": "^1.8",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.5",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^3.8",
        "maatwebsite/excel": "^3.1",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-db-snapshots": "^2.4",
        "spatie/laravel-login-link": "^1.1",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/simple-excel": "^3.1",
        "wireui/wireui": "^1.15"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.12",
        "spatie/laravel-web-tinker": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
